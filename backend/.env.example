# Portfolio Backend Environment Configuration
PORT=5000

# ── Email Delivery ──────────────────────────────────────────────────────────
# Brevo (formerly Sendinblue) Transactional Email API Key
# Generate at: https://app.brevo.com/settings/keys/api
# REQUIRED for contact form email delivery.
BREVO_API_KEY=

# Verified Sender (must be verified in your Brevo account)
BREVO_SENDER_EMAIL=jebaraj1364@gmail.com
BREVO_SENDER_NAME=Jebaraj.P

# Owner email that receives all enquiry notifications
OWNER_EMAIL=jebaraj1364@gmail.com

# ── Optional SMTP Fallback ──────────────────────────────────────────────────
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_password

# ── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_URL=https://wa.me/qr/FT5PXECCGTFRG1

# ── CORS ────────────────────────────────────────────────────────────────────
# Production frontend domain (e.g. https://jebaraj.dev or your Vercel URL)
# Leave blank during local development
CORS_ALLOWED_ORIGIN=https://your-production-domain.com

# ── Rate Limiter Storage ────────────────────────────────────────────────────
# For multi-worker production deployments, use Redis:
# LIMITER_STORAGE_URI=redis://localhost:6379
LIMITER_STORAGE_URI=memory://
